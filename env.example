# ======================================
# 🎵 Discord Music Bot - Configuração
# ======================================

# 🔑 Token Discord (OBRIGATÓRIO)
# Como obter: https://discord.com/developers/applications
# Copie o token do seu bot em "Bot" > "TOKEN"
# ⚠️  NUNCA compartilhe este token!
DISCORD_TOKEN=seu_token_aqui

# 🎯 Prefixo dos comandos
# Exemplos: ! ? . >> 
# Padrão: !
PREFIX=!

# 📁 Diretório de dados
# Onde salva favoritos, logs, etc.
# Padrão: ./data (relativo ao bot.py)
DATA_DIR=./data

# 📊 Limite máximo de vídeos em playlist
# Se playlist > este número, só carrega os primeiros
# Padrão: 200 (recomendado 100-300)
PLAYLIST_LIMIT=200

# ⏱️ Timeout de inatividade (segundos)
# Bot desconecta se vazio por este tempo
# Padrão: 60 (1 minuto)
# Mínimo: 10
IDLE_TIMEOUT=60

# 🌐 BGUtil URL (Opcional)
# Para bypass de geo-bloqueio do YouTube
# Deixe em branco se não usar
# Exemplo: http://seu-servidor:4416
BGUTIL_URL=

# 🍪 Cookies do YouTube (Opcional)
# Arquivo para autenticação no YouTube
# Deixe em branco se não usar
# Exemplo: ./cookies.txt
COOKIES_FILE=

# 🔊 Caminho do FFmpeg
# Padrão: ffmpeg (procura no PATH)
# Outros: /usr/bin/ffmpeg, /usr/local/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# 📝 Nível de logging
# Opções: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Padrão: INFO
LOG_LEVEL=INFO

# ======================================
# ✅ PRÓXIMOS PASSOS:
# ======================================
# 1. Preencha DISCORD_TOKEN
# 2. Customize outros campos se necessário
# 3. Não compartilhe este arquivo
# 4. Execute: python3 bot.py
# ======================================
